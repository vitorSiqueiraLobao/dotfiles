{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,
    "height": 34,
    "spacing": 0,

    "modules-left": [
        "custom/ares-badge",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "custom/gpu",
        "disk",
        "network",
        "custom/mixer",
        "custom/theme",
        "tray"
    ],

    "custom/ares-badge": {
        "format": "▓▒░ ARES ░▒▓",
        "tooltip-format": "Menu do sistema",
        "on-click": "$HOME/.config/waybar/scripts/power_menu.py"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "[{name}]",
        "format-icons": {
            "default": ""
        }
    },

    "hyprland/window": {
        "format": "<span color='#ff1f3d'>║</span> {title}",
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "<span color='#ff1f3d'>║</span> {0:%H:%M:%S} <span color='#7a6f73'>──</span> {0:%d.%m.%Y} <span color='#ff1f3d'>║</span>",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "format": {
                "months": "<span color='#ff1f3d'><b>{}</b></span>",
                "weekdays": "<span color='#7a6f73'>{}</span>",
                "today": "<span color='#00f0ff'><b>{}</b></span>"
            }
        }
    },

    // Medidores ASCII: {icon} escolhe um dos 9 estágios conforme a %
    "cpu": {
        "interval": 2,
        "format": "CPU <span color='#00f0ff'>{icon}</span> {usage}%",
        "format-icons": ["[<span color='#2a4a50'>░░░░░░░░</span>]", "[█<span color='#2a4a50'>░░░░░░░</span>]", "[██<span color='#2a4a50'>░░░░░░</span>]", "[███<span color='#2a4a50'>░░░░░</span>]", "[████<span color='#2a4a50'>░░░░</span>]", "[█████<span color='#2a4a50'>░░░</span>]", "[██████<span color='#2a4a50'>░░</span>]", "[███████<span color='#2a4a50'>░</span>]", "[████████]"],
        "on-click": "kitty --class btop-term -e btop"
    },

    "temperature": {
        "interval": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 80,
        "format": "TEMP <span color='#00f0ff'>{temperatureC}°C</span>",
        "format-critical": "TEMP <span color='#ff1f3d'>{temperatureC}°C !</span>",
        "on-click": "kitty --class btop-term -e btop"
    },

    "memory": {
        "interval": 2,
        "format": "RAM <span color='#00f0ff'>{icon}</span> {used:0.1f}G",
        "format-icons": ["[<span color='#2a4a50'>░░░░░░░░</span>]", "[█<span color='#2a4a50'>░░░░░░░</span>]", "[██<span color='#2a4a50'>░░░░░░</span>]", "[███<span color='#2a4a50'>░░░░░</span>]", "[████<span color='#2a4a50'>░░░░</span>]", "[█████<span color='#2a4a50'>░░░</span>]", "[██████<span color='#2a4a50'>░░</span>]", "[███████<span color='#2a4a50'>░</span>]", "[████████]"],
        "tooltip-format": "Usado: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
        "on-click": "kitty --class btop-term -e btop"
    },

    "custom/gpu": {
        "exec": "$HOME/.config/waybar/scripts/gpu_telemetry.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "kitty --class btop-term -e btop"
    },

    "disk": {
        "interval": 30,
        "format": "DISK <span color='#00f0ff'>{percentage_used}%</span>",
        "path": "/",
        "tooltip-format": "Disco: {used} usado / {total} total ({free} livre)"
    },

    "network": {
        "interval": 3,
        "format-wifi": "NET <span color='#00f0ff'>{essid}</span>",
        "format-ethernet": "NET <span color='#00f0ff'>ETH</span>",
        "format-disconnected": "NET <span color='#ff1f3d'>OFF</span>",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "custom/mixer": {
        "format": "󰕾",
        "tooltip-format": "Mixer de volume",
        "on-click": "$HOME/.config/waybar/scripts/volume_mixer.py",
        "on-click-right": "$HOME/.config/waybar/scripts/switch_audio_output.sh"
    },

    "custom/theme": {
        "exec": "$HOME/.config/waybar/scripts/theme_toggle.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "$HOME/.config/waybar/scripts/theme_toggle.sh toggle"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
