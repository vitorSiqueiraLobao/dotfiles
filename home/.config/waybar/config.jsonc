{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,
    "height": 34,
    "spacing": 0,

    "modules-left": [
        "custom/ares-badge",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "custom/gpu",
        "disk",
        "network",
        "pulseaudio",
        "custom/mixer",
        "custom/theme",
        "tray"
    ],

    "custom/ares-badge": {
        "format": "ARES//SYS",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "[{name}]",
        "format-icons": {
            "default": ""
        }
    },

    "hyprland/window": {
        "format": "│ {title}",
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "TIME::{0:%H:%M:%S} ── DATE::{0:%Y.%m.%d}",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU::{usage}%",
        "on-click": "kitty --class btop-term -e btop"
    },

    "temperature": {
        "interval": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 80,
        "format": "TEMP::{temperatureC}°C",
        "on-click": "kitty --class btop-term -e btop"
    },

    "memory": {
        "interval": 2,
        "format": "RAM::{used:0.1f}G",
        "tooltip-format": "Used: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
        "on-click": "kitty --class btop-term -e btop"
    },

    "custom/gpu": {
        "exec": "$HOME/.config/waybar/scripts/gpu_telemetry.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "kitty --class btop-term -e btop"
    },

    "disk": {
        "interval": 30,
        "format": "DISK::{percentage_used}%",
        "path": "/",
        "tooltip-format": "Storage: {used} used / {total} total ({free} free)"
    },

    "network": {
        "interval": 3,
        "format-wifi": "NET::{essid}",
        "format-ethernet": "NET::ETH",
        "format-disconnected": "NET::OFF",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "format": "VOL::{volume}%",
        "format-muted": "VOL::MUTED",
        "scroll-step": 5,
        "on-click": "/home/w0lf/.config/waybar/scripts/toggle_audio_mixer.sh",
        "on-click-right": "/home/w0lf/.config/waybar/scripts/switch_audio_output.sh"
    },

    "custom/mixer": {
        "format": "󰕾",
        "tooltip-format": "Mixer de volume",
        "on-click": "$HOME/.config/waybar/scripts/volume_mixer.py"
    },

    "custom/theme": {
        "exec": "$HOME/.config/waybar/scripts/theme_toggle.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "$HOME/.config/waybar/scripts/theme_toggle.sh toggle"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
