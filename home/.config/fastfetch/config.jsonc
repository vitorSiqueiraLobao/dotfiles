{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/ares.txt",
        "color": {
            "1": "38;2;234;234;234",
            "2": "38;2;80;80;80",
            "3": "38;2;230;230;230"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ─► ",
        "color": {
            "keys": "blue",
            "title": "white"
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "OS   "
        },
        {
            "type": "kernel",
            "key": "KRNL "
        },
        {
            "type": "wm",
            "key": "WM   "
        },
        {
            "type": "terminal",
            "key": "TERM "
        },
        {
            "type": "shell",
            "key": "SH   "
        },
        {
            "type": "cpu",
            "key": "CPU  "
        },
        {
            "type": "gpu",
            "key": "GPU  "
        },
        {
            "type": "memory",
            "key": "MEM  "
        },
        {
            "type": "uptime",
            "key": "UP   "
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "colors",
            "symbol": "block",
            "block": {
                "range": [0, 7]
            }
        }
    ]
}
