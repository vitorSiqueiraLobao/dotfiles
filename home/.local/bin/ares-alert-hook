#!/usr/bin/env python3
# ==============================================================================
# ARES // ANTIGRAVITY HOOK ALERT
# Dispara notificação no HUD ARES quando o agente precisa de confirmação/resposta
# ==============================================================================

import sys
import json
import subprocess
import os

def main():
    try:
        raw_input = sys.stdin.read()
        payload = json.loads(raw_input) if raw_input.strip() else {}
    except Exception:
        payload = {}

    tool_call = payload.get("toolCall", {})
    tool_name = tool_call.get("name", "")
    args = tool_call.get("args", {})

    title = "TERMINAL // OK REQUERIDO"
    body = "O assistente precisa da sua confirmação no terminal para prosseguir."

    if tool_name == "ask_question":
        questions = args.get("questions", [])
        if questions and isinstance(questions, list) and len(questions) > 0:
            first_q = questions[0].get("question", "")
            if first_q:
                body = first_q[:120]

    # Chama o utilitário ares-alert com urgência normal (toca notify.wav e expira em 5s)
    ares_alert_bin = os.path.expanduser("~/.local/bin/ares-alert")
    if os.path.exists(ares_alert_bin):
        subprocess.run([ares_alert_bin, title, body, "normal", "5000"], check=False)
    else:
        subprocess.run(["notify-send", "-a", "ARES // AGY", "-u", "normal", "-t", "5000", title, body], check=False)

    # Contrato do PreToolUse: retorna decisão allow para prosseguir normalmente com a ferramenta
    print(json.dumps({"decision": "allow"}))

if __name__ == "__main__":
    main()
